DATABASE_URL=postgresql://opentutor:opentutor@127.0.0.1:54329/opentutor
REDIS_URL=redis://127.0.0.1:6389
PORT=3330
OPENTUTOR_DATA_DIR=.data
OPENTUTOR_BASE_URL=http://127.0.0.1:3330
PYTHON_PATH=.venv/bin/python
# Local self-hosted mode. Bind Web to loopback; set AUTH_TOKEN before exposing it.
AUTH_TOKEN=
# Leave unset to use the model configured in Codex. Run codex login first.
CODEX_MODEL=
# Explicit workload setting; do not inherit a desktop Codex ultra reasoning default.
CODEX_REASONING_EFFORT=medium
# Optional: route only Codex model traffic through your existing proxy.
CODEX_PROXY_URL=
# Optional: an existing Codex binary. Default uses the SDK-bundled runtime.
CODEX_PATH=
CODEX_TIMEOUT_MS=240000
WORKER_CONCURRENCY=1
# Optional: browser pages per export. Empty auto-budgets CPU and memory across workers.
RENDER_CONCURRENCY=
# Let Chrome choose graphics acceleration. Set swangle only for software compatibility.
RENDER_GL=auto
