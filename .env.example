DATABASE_URL=postgresql://opentutor:opentutor@127.0.0.1:54329/opentutor
REDIS_URL=redis://127.0.0.1:6389
PORT=3330
OPENTUTOR_DATA_DIR=.data
OPENTUTOR_BASE_URL=http://127.0.0.1:3330
PYTHON_PATH=.venv/bin/python
# Local self-hosted mode. Bind Web to loopback; set AUTH_TOKEN before exposing it.
AUTH_TOKEN=
# Models are configured in the web UI ("模型设置"): GLM, DeepSeek, OpenAI or any OpenAI-compatible endpoint.
# API keys are stored AES-256-GCM encrypted in PostgreSQL. Master key; empty = auto-generated .data/secret.key
OPENTUTOR_SECRET_KEY=
# Optional headless fallback, used only while no model is configured in the UI.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_VISION_MODEL=
LLM_JSON_MODE=json_object
LLM_TIMEOUT_MS=300000
# Proxy for model traffic (Node >= 22.21 / 24): NODE_USE_ENV_PROXY=1 HTTPS_PROXY=http://127.0.0.1:7890 npm run dev
WORKER_CONCURRENCY=1
# Optional: browser pages per export. Empty auto-budgets CPU and memory across workers.
RENDER_CONCURRENCY=
# Let Chrome choose graphics acceleration. Set swangle only for software compatibility.
RENDER_GL=auto
